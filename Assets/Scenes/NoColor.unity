    - target: {fileID: 5543133499646338922, guid: 7e21bcd968de0424e939f2ba3821b9cc, type: 3}
      propertyPath: scrollContent
      value: "From the place where the light shines,\ngo left\u2026 then left again\u2026\nCross
        the river, and once more, turn to your left.\n\nWhen you bring light to the
        left and wait,\nthat which you seek shall be waiting.\n\nAnd there,\nwhat
        I have left behind shall also await you.\nYou must find it."
      objectReference: {fileID: 0}
